rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerifiedSignedIn() && request.auth.token.email == 'generaskagiraneza@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isVerifiedSignedIn() &&
        exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.active == true;
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    // 3. Entity Validation Blueprints (No existing() or diff() inside validators)

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidString(data.email, 3, 160) &&
        data.createdAt is timestamp;
    }

    function isValidStaffAccess(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'phone', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'role', 'phone', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidString(data.name, 1, 100) &&
        data.role in ['Owner', 'Admin', 'Cashier', 'Kitchen', 'Delivery Manager', 'Rider'] &&
        isValidString(data.phone, 4, 30) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'price', 'imageUrl', 'available', 'prepMinutes', 'recipe', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'description', 'price', 'imageUrl', 'available', 'bestseller', 'featured', 'prepMinutes', 'comboUpgradePrice', 'sizes', 'extras', 'recipe', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        data.category in ['Burgers', 'Chicken', 'Pizza', 'Fries', 'Drinks', 'Combos'] &&
        isValidString(data.description, 1, 500) &&
        data.price is number && data.price >= 0 &&
        isValidString(data.imageUrl, 1, 500) &&
        data.available is bool &&
        isOptionalBool(data, 'bestseller') &&
        isOptionalBool(data, 'featured') &&
        data.prepMinutes is number && data.prepMinutes >= 0 &&
        isOptionalNumber(data, 'comboUpgradePrice') &&
        (!( 'sizes' in data ) || (data.sizes is list && data.sizes.size() <= 10 && (data.sizes.size() == 0 || data.sizes[0] is map))) &&
        (!( 'extras' in data ) || (data.extras is list && data.extras.size() <= 20 && (data.extras.size() == 0 || data.extras[0] is map))) &&
        data.recipe is list && data.recipe.size() <= 20 && (data.recipe.size() == 0 || data.recipe[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGroupPackage(data) {
      return data.keys().hasAll(['id', 'name', 'audience', 'headcount', 'description', 'pricePerPack', 'itemsSummary', 'imageUrl', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'audience', 'headcount', 'description', 'pricePerPack', 'itemsSummary', 'imageUrl', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        data.audience in ['Office', 'School', 'Party'] &&
        data.headcount is number && data.headcount >= 1 &&
        isValidString(data.description, 1, 500) &&
        data.pricePerPack is number && data.pricePerPack >= 0 &&
        data.itemsSummary is list && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 15 &&
        data.itemsSummary[0] is string &&
        isValidString(data.imageUrl, 1, 500) &&
        data.updatedAt is timestamp;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'type', 'value', 'minOrderAmount', 'scheduleLabel', 'active', 'ordersGenerated', 'revenueGenerated', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'code', 'type', 'value', 'minOrderAmount', 'scheduleLabel', 'active', 'ordersGenerated', 'revenueGenerated', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.code, 2, 32) &&
        data.type in ['Percentage', 'Fixed', 'Free Delivery', 'First Order', 'Birthday', 'Group Offer', 'Referral'] &&
        data.value is number && data.value >= 0 &&
        data.minOrderAmount is number && data.minOrderAmount >= 0 &&
        isValidString(data.scheduleLabel, 1, 80) &&
        data.active is bool &&
        data.ordersGenerated is number && data.ordersGenerated >= 0 &&
        data.revenueGenerated is number && data.revenueGenerated >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['restaurantName', 'tagline', 'address', 'locationPin', 'phone', 'whatsappNumber', 'openingHours', 'currency', 'deliveryFeeBase', 'freeDeliveryThreshold', 'deliveryTargetMinutes', 'activePromoBanner', 'sandboxMode', 'updatedAt']) &&
        data.keys().hasOnly(['restaurantName', 'tagline', 'address', 'locationPin', 'phone', 'whatsappNumber', 'openingHours', 'currency', 'deliveryFeeBase', 'freeDeliveryThreshold', 'deliveryTargetMinutes', 'activePromoBanner', 'sandboxMode', 'updatedAt']) &&
        isValidString(data.restaurantName, 1, 100) &&
        isValidString(data.tagline, 1, 240) &&
        isValidString(data.address, 1, 200) &&
        isValidString(data.locationPin, 1, 64) &&
        isValidString(data.phone, 4, 30) &&
        isValidString(data.whatsappNumber, 4, 30) &&
        isValidString(data.openingHours, 1, 100) &&
        isValidString(data.currency, 2, 10) &&
        data.deliveryFeeBase is number && data.deliveryFeeBase >= 0 &&
        data.freeDeliveryThreshold is number && data.freeDeliveryThreshold >= 0 &&
        data.deliveryTargetMinutes is number && data.deliveryTargetMinutes >= 1 &&
        data.activePromoBanner is string && data.activePromoBanner.size() <= 240 &&
        data.sandboxMode is map &&
        data.sandboxMode.keys().hasAll(['mtnMomoEnabled', 'airtelMoneyEnabled', 'whatsappApiSandbox', 'smsGatewaySandbox']) &&
        data.sandboxMode.keys().hasOnly(['mtnMomoEnabled', 'airtelMoneyEnabled', 'whatsappApiSandbox', 'smsGatewaySandbox']) &&
        data.sandboxMode.mtnMomoEnabled is bool &&
        data.sandboxMode.airtelMoneyEnabled is bool &&
        data.sandboxMode.whatsappApiSandbox is bool &&
        data.sandboxMode.smsGatewaySandbox is bool &&
        data.updatedAt is timestamp;
    }

    function isValidQRChannel(data) {
      return data.keys().hasAll(['id', 'label', 'channelType', 'sourceCode', 'scans', 'ordersCount', 'revenue', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'label', 'channelType', 'sourceCode', 'scans', 'ordersCount', 'revenue', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.label, 1, 100) &&
        data.channelType in ['Table', 'Flyer', 'Packaging', 'Social'] &&
        isValidString(data.sourceCode, 1, 64) && data.sourceCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.scans is number && data.scans >= 0 &&
        data.ordersCount is number && data.ordersCount >= 0 &&
        data.revenue is number && data.revenue >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'phone', 'firstOrderAt', 'lastOrderAt', 'orderCount', 'totalSpent', 'burgerStamps', 'loyaltyPoints', 'rewardsAvailable', 'favoriteItems', 'segment', 'notes', 'marketingOptIn', 'referralCode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'phone', 'email', 'birthday', 'firstOrderAt', 'lastOrderAt', 'orderCount', 'totalSpent', 'burgerStamps', 'loyaltyPoints', 'rewardsAvailable', 'favoriteItems', 'segment', 'notes', 'marketingOptIn', 'referralCode', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.phone, 4, 30) &&
        isOptionalString(data, 'email', 160) &&
        isOptionalString(data, 'birthday', 20) &&
        isValidString(data.firstOrderAt, 1, 64) &&
        isValidString(data.lastOrderAt, 1, 64) &&
        data.orderCount is number && data.orderCount >= 0 &&
        data.totalSpent is number && data.totalSpent >= 0 &&
        data.burgerStamps is number && data.burgerStamps >= 0 && data.burgerStamps < 5 &&
        data.loyaltyPoints is number && data.loyaltyPoints >= 0 &&
        data.rewardsAvailable is number && data.rewardsAvailable >= 0 &&
        data.favoriteItems is list && data.favoriteItems.size() <= 10 && (data.favoriteItems.size() == 0 || data.favoriteItems[0] is string) &&
        data.segment in ['First-Time', 'Returning', 'VIP', 'At-Risk'] &&
        data.notes is string && data.notes.size() <= 500 &&
        data.marketingOptIn is bool &&
        isValidString(data.referralCode, 2, 32) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'orderNumber', 'createdAt', 'updatedAt', 'createdAtIso', 'updatedAtIso', 'customerId', 'customerName', 'customerPhone', 'marketingOptIn', 'fulfillmentType', 'items', 'subtotal', 'discount', 'deliveryFee', 'total', 'paymentMethod', 'paymentStatus', 'paymentReference', 'status', 'statusHistory', 'priority', 'estimatedMinutes', 'inventoryDeducted', 'whatsAppSent']) &&
        data.keys().hasOnly(['id', 'userId', 'orderNumber', 'createdAt', 'updatedAt', 'createdAtIso', 'updatedAtIso', 'scheduledFor', 'isGroupOrder', 'groupOrgName', 'qrSource', 'customerId', 'customerName', 'customerPhone', 'customerEmail', 'marketingOptIn', 'fulfillmentType', 'deliveryZone', 'deliveryAddress', 'locationPin', 'items', 'subtotal', 'discount', 'promoCode', 'deliveryFee', 'total', 'paymentMethod', 'paymentStatus', 'paymentReference', 'status', 'statusHistory', 'priority', 'kitchenAssignee', 'riderId', 'riderName', 'estimatedMinutes', 'deliveredAt', 'cancellationReason', 'refundAmount', 'inventoryDeducted', 'whatsAppSent', 'feedbackSubmitted']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.orderNumber, 3, 32) && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        isValidString(data.createdAtIso, 1, 64) &&
        isValidString(data.updatedAtIso, 1, 64) &&
        isOptionalString(data, 'scheduledFor', 64) &&
        isOptionalBool(data, 'isGroupOrder') &&
        isOptionalString(data, 'groupOrgName', 120) &&
        isOptionalString(data, 'qrSource', 64) &&
        isValidId(data.customerId) &&
        isValidString(data.customerName, 1, 120) &&
        isValidString(data.customerPhone, 4, 30) &&
        isOptionalString(data, 'customerEmail', 160) &&
        data.marketingOptIn is bool &&
        data.fulfillmentType in ['Delivery', 'Pickup'] &&
        isOptionalString(data, 'deliveryZone', 80) &&
        isOptionalString(data, 'deliveryAddress', 240) &&
        isOptionalString(data, 'locationPin', 64) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 40 && data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discount is number && data.discount >= 0 &&
        isOptionalString(data, 'promoCode', 32) &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.total is number && data.total >= 0 &&
        data.paymentMethod in ['MTN Mobile Money', 'Airtel Money', 'Pay on Delivery', 'Pay at Restaurant'] &&
        data.paymentStatus in ['Pending', 'Confirmed', 'Failed', 'Refunded'] &&
        isValidString(data.paymentReference, 2, 64) &&
        data.status in ['New order received', 'Order confirmed', 'Preparing food', 'Ready for pickup', 'Assigned to rider', 'Out for delivery', 'Delivered', 'Completed', 'Cancelled'] &&
        data.statusHistory is list && data.statusHistory.size() >= 1 && data.statusHistory.size() <= 20 && data.statusHistory[0] is map &&
        data.priority in ['Normal', 'High'] &&
        isOptionalString(data, 'kitchenAssignee', 100) &&
        isOptionalString(data, 'riderId', 128) &&
        isOptionalString(data, 'riderName', 100) &&
        data.estimatedMinutes is number && data.estimatedMinutes >= 1 &&
        isOptionalString(data, 'deliveredAt', 64) &&
        isOptionalString(data, 'cancellationReason', 240) &&
        isOptionalNumber(data, 'refundAmount') &&
        data.inventoryDeducted is bool &&
        data.whatsAppSent is bool &&
        isOptionalBool(data, 'feedbackSubmitted');
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'userId', 'orderId', 'orderNumber', 'customerName', 'customerPhone', 'rating', 'foodRating', 'deliveryRating', 'comment', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'orderId', 'orderNumber', 'customerName', 'customerPhone', 'rating', 'foodRating', 'deliveryRating', 'comment', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.orderId) &&
        isValidString(data.orderNumber, 3, 32) &&
        isValidString(data.customerName, 1, 120) &&
        isValidString(data.customerPhone, 4, 30) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.foodRating is number && data.foodRating >= 1 && data.foodRating <= 5 &&
        data.deliveryRating is number && data.deliveryRating >= 1 && data.deliveryRating <= 5 &&
        isValidString(data.comment, 1, 600) &&
        data.status in ['Open', 'Resolved', 'Google Review Requested'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRider(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'vehicleType', 'plateNumber', 'status', 'completedDeliveries', 'failedDeliveries', 'avgDeliveryMinutes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'phone', 'vehicleType', 'plateNumber', 'status', 'completedDeliveries', 'failedDeliveries', 'avgDeliveryMinutes', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 100) &&
        isValidString(data.phone, 4, 30) &&
        data.vehicleType in ['Motorbike', 'Bicycle', 'Van'] &&
        isValidString(data.plateNumber, 2, 30) &&
        data.status in ['Available', 'On Delivery', 'Offline'] &&
        data.completedDeliveries is number && data.completedDeliveries >= 0 &&
        data.failedDeliveries is number && data.failedDeliveries >= 0 &&
        data.avgDeliveryMinutes is number && data.avgDeliveryMinutes >= 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIngredient(data) {
      return data.keys().hasAll(['id', 'name', 'unit', 'currentStock', 'reorderLevel', 'unitCost', 'supplierName', 'lastRestockedAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'unit', 'currentStock', 'reorderLevel', 'unitCost', 'supplierName', 'lastRestockedAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.unit, 1, 24) &&
        data.currentStock is number && data.currentStock >= 0 &&
        data.reorderLevel is number && data.reorderLevel >= 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        isValidString(data.supplierName, 1, 120) &&
        isValidString(data.lastRestockedAt, 1, 64) &&
        data.updatedAt is timestamp;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['id', 'ingredientId', 'ingredientName', 'delta', 'reason', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ingredientId', 'ingredientName', 'delta', 'reason', 'referenceId', 'timestamp', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ingredientId) &&
        isValidString(data.ingredientName, 1, 120) &&
        data.delta is number &&
        data.reason in ['Order Deduction', 'Restock Purchase', 'Manual Adjustment', 'Waste'] &&
        isOptionalString(data, 'referenceId', 64) &&
        isValidString(data.timestamp, 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidPurchase(data) {
      return data.keys().hasAll(['id', 'supplierName', 'ingredientId', 'ingredientName', 'quantity', 'totalCost', 'purchasedAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'supplierName', 'ingredientId', 'ingredientName', 'quantity', 'totalCost', 'purchasedAt', 'createdAt']) &&
        isValidId(data.id) &&
        isValidString(data.supplierName, 1, 120) &&
        isValidId(data.ingredientId) &&
        isValidString(data.ingredientName, 1, 120) &&
        data.quantity is number && data.quantity > 0 &&
        data.totalCost is number && data.totalCost >= 0 &&
        isValidString(data.purchasedAt, 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'category', 'description', 'amount', 'recordedAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'category', 'description', 'amount', 'recordedAt', 'createdAt']) &&
        isValidId(data.id) &&
        data.category in ['Ingredients', 'Delivery', 'Utilities', 'Marketing', 'Staff', 'Other'] &&
        isValidString(data.description, 1, 240) &&
        data.amount is number && data.amount > 0 &&
        isValidString(data.recordedAt, 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidAutomationRule(data) {
      return data.keys().hasAll(['id', 'name', 'channel', 'trigger', 'enabled', 'sentCount', 'conversionCount', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'channel', 'trigger', 'enabled', 'sentCount', 'conversionCount', 'lastTriggeredAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        data.channel in ['WhatsApp Sandbox', 'SMS Sandbox'] &&
        isValidString(data.trigger, 1, 120) &&
        data.enabled is bool &&
        data.sentCount is number && data.sentCount >= 0 &&
        data.conversionCount is number && data.conversionCount >= 0 &&
        isOptionalString(data, 'lastTriggeredAt', 64) &&
        data.updatedAt is timestamp;
    }

    function isValidAutomationLog(data) {
      return data.keys().hasAll(['id', 'ruleName', 'channel', 'recipientName', 'recipientPhone', 'message', 'sentAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ruleName', 'channel', 'recipientName', 'recipientPhone', 'message', 'sentAt', 'createdAt']) &&
        isValidId(data.id) &&
        isValidString(data.ruleName, 1, 120) &&
        isValidString(data.channel, 1, 60) &&
        isValidString(data.recipientName, 1, 120) &&
        isValidString(data.recipientPhone, 4, 30) &&
        isValidString(data.message, 1, 500) &&
        isValidString(data.sentAt, 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'phone', 'active', 'lastActiveAt', 'permissions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'phone', 'active', 'lastActiveAt', 'permissions', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 100) &&
        data.role in ['Owner', 'Admin', 'Cashier', 'Kitchen', 'Delivery Manager', 'Rider'] &&
        isValidString(data.phone, 4, 30) &&
        data.active is bool &&
        isValidString(data.lastActiveAt, 1, 64) &&
        data.permissions is list && data.permissions.size() >= 1 && data.permissions.size() <= 10 &&
        data.permissions[0] is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffActivity(data) {
      return data.keys().hasAll(['id', 'staffName', 'role', 'action', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['id', 'staffName', 'role', 'action', 'timestamp', 'createdAt']) &&
        isValidId(data.id) &&
        isValidString(data.staffName, 1, 100) &&
        data.role in ['Owner', 'Admin', 'Cashier', 'Kitchen', 'Delivery Manager', 'Rider'] &&
        isValidString(data.action, 1, 240) &&
        isValidString(data.timestamp, 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidTakeoverRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'customerPrompt', 'resolved', 'createdAt', 'createdAtIso']) &&
        data.keys().hasOnly(['id', 'userId', 'customerPrompt', 'resolved', 'createdAt', 'createdAtIso']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.customerPrompt, 1, 500) &&
        data.resolved is bool &&
        data.createdAt is timestamp &&
        isValidString(data.createdAtIso, 1, 64);
    }

    // 4. Collection Match Blocks

    // Connection probe document
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Trusted Admin & Staff RBAC collections
    match /admins/{uid} {
      allow get: if isValidId(uid) && isVerifiedSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(uid) && isAdmin() && isValidAdminRole(incoming()) && incoming().uid == uid && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(uid) && isBootstrappedAdmin() && uid != request.auth.uid;
    }

    match /staffUsers/{uid} {
      allow get: if isValidId(uid) && isVerifiedSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(uid) && isAdmin() && isValidStaffAccess(incoming()) && incoming().uid == uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(uid) && isAdmin() && isValidStaffAccess(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'phone', 'active', 'updatedAt']);
      allow delete: if isValidId(uid) && isAdmin();
    }

    // Public Storefront Catalog & Store Config (Non-PII)
    match /menu/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if request.query.limit <= 200;
      allow create: if isValidId(itemId) && isStaffOrAdmin() && isValidMenuItem(incoming()) && incoming().id == itemId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isStaffOrAdmin() && isValidMenuItem(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['available', 'bestseller', 'updatedAt'])
      );
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /groupPackages/{pkgId} {
      allow get: if isValidId(pkgId);
      allow list: if request.query.limit <= 100;
      allow create: if isValidId(pkgId) && isAdmin() && isValidGroupPackage(incoming()) && incoming().id == pkgId && incoming().updatedAt == request.time;
      allow update: if isValidId(pkgId) && isAdmin() && isValidGroupPackage(incoming()) && incoming().id == existing().id && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'audience', 'headcount', 'description', 'pricePerPack', 'itemsSummary', 'imageUrl', 'updatedAt']);
      allow delete: if isValidId(pkgId) && isAdmin();
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if request.query.limit <= 100;
      allow create: if isValidId(campaignId) && isAdmin() && isValidCampaign(incoming()) && incoming().id == campaignId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(campaignId) && isAdmin() && isValidCampaign(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'type', 'value', 'minOrderAmount', 'scheduleLabel', 'active', 'ordersGenerated', 'revenueGenerated', 'updatedAt'])
      );
      allow delete: if isValidId(campaignId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if settingId == 'public';
      allow list: if false;
      allow create: if settingId == 'public' && isAdmin() && isValidStoreSettings(incoming()) && incoming().updatedAt == request.time;
      allow update: if settingId == 'public' && isAdmin() && isValidStoreSettings(incoming()) && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['restaurantName', 'tagline', 'address', 'locationPin', 'phone', 'whatsappNumber', 'openingHours', 'currency', 'deliveryFeeBase', 'freeDeliveryThreshold', 'deliveryTargetMinutes', 'activePromoBanner', 'sandboxMode', 'updatedAt']);
      allow delete: if false;
    }

    match /qrChannels/{qrId} {
      allow get: if isValidId(qrId);
      allow list: if request.query.limit <= 100;
      allow create: if isValidId(qrId) && isAdmin() && isValidQRChannel(incoming()) && incoming().id == qrId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(qrId) && isVerifiedSignedIn() && isValidQRChannel(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['scans', 'updatedAt']) && incoming().scans == existing().scans + 1)
      );
      allow delete: if isValidId(qrId) && isAdmin();
    }

    // PII-Isolated Customer CRM Profiles
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isVerifiedSignedIn() && (request.auth.uid == customerId || isStaffOrAdmin());
      allow list: if isVerifiedSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(customerId) && isVerifiedSignedIn() && isValidCustomer(incoming()) && incoming().id == customerId && (incoming().userId == request.auth.uid || isAdmin()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(customerId) && isVerifiedSignedIn() && isValidCustomer(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'lastOrderAt', 'orderCount', 'totalSpent', 'burgerStamps', 'loyaltyPoints', 'rewardsAvailable', 'favoriteItems', 'segment', 'marketingOptIn', 'updatedAt'])) ||
        (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'marketingOptIn', 'updatedAt']))
      );
      allow delete: if isValidId(customerId) && isAdmin();
    }

    // Customer Orders (PII + Financial + Terminal State Locking)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isVerifiedSignedIn() && (existing().userId == request.auth.uid || isStaffOrAdmin());
      allow list: if isVerifiedSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(orderId) && isVerifiedSignedIn() && isValidOrder(incoming()) && incoming().id == orderId && incoming().createdAt == request.time && incoming().updatedAt == request.time && (
        isAdmin() ||
        (
          incoming().userId == request.auth.uid &&
          incoming().customerId == request.auth.uid &&
          incoming().status == 'New order received' &&
          incoming().inventoryDeducted == false &&
          (incoming().paymentMethod in ['MTN Mobile Money', 'Airtel Money'] || incoming().paymentStatus == 'Pending')
        )
      );
      allow update: if isValidId(orderId) && isVerifiedSignedIn() && isValidOrder(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().customerId == existing().customerId && incoming().orderNumber == existing().orderNumber && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (
          !(existing().status in ['Completed', 'Cancelled']) &&
          isStaff() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusHistory', 'paymentStatus', 'kitchenAssignee', 'riderId', 'riderName', 'deliveredAt', 'cancellationReason', 'refundAmount', 'inventoryDeducted', 'updatedAt', 'updatedAtIso'])
        ) ||
        (
          existing().userId == request.auth.uid &&
          existing().status in ['Delivered', 'Completed'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['feedbackSubmitted', 'updatedAt', 'updatedAtIso']) &&
          incoming().feedbackSubmitted == true
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Feedback Entries (Requires verified owning order)
    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && isVerifiedSignedIn() && (existing().userId == request.auth.uid || isStaffOrAdmin());
      allow list: if isVerifiedSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(feedbackId) && isVerifiedSignedIn() && isValidFeedback(incoming()) && incoming().id == feedbackId && incoming().userId == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
        get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid;
      allow update: if isValidId(feedbackId) && isStaffOrAdmin() && isValidFeedback(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().orderId == existing().orderId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    // Operational Collections (Staff / Admin)
    match /riders/{riderId} {
      allow get: if isValidId(riderId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(riderId) && isStaffOrAdmin() && isValidRider(incoming()) && incoming().id == riderId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(riderId) && isStaffOrAdmin() && isValidRider(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedDeliveries', 'failedDeliveries', 'updatedAt'])
      );
      allow delete: if isValidId(riderId) && isAdmin();
    }

    match /ingredients/{ingredientId} {
      allow get: if isValidId(ingredientId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(ingredientId) && isAdmin() && isValidIngredient(incoming()) && incoming().id == ingredientId && incoming().updatedAt == request.time;
      allow update: if isValidId(ingredientId) && isStaffOrAdmin() && isValidIngredient(incoming()) && incoming().id == existing().id && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'lastRestockedAt', 'updatedAt'])
      );
      allow delete: if isValidId(ingredientId) && isAdmin();
    }

    match /stockMovements/{movementId} {
      allow get: if isValidId(movementId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(movementId) && isStaffOrAdmin() && isValidStockMovement(incoming()) && incoming().id == movementId && incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/ingredients/$(incoming().ingredientId));
      allow update: if false;
      allow delete: if isValidId(movementId) && isAdmin();
    }

    match /purchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(purchaseId) && isStaffOrAdmin() && isValidPurchase(incoming()) && incoming().id == purchaseId && incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/ingredients/$(incoming().ingredientId));
      allow update: if false;
      allow delete: if isValidId(purchaseId) && isAdmin();
    }

    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(expenseId) && isAdmin() && isValidExpense(incoming()) && incoming().id == expenseId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(expenseId) && isAdmin();
    }

    match /automations/{ruleId} {
      allow get: if isValidId(ruleId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(ruleId) && isAdmin() && isValidAutomationRule(incoming()) && incoming().id == ruleId && incoming().updatedAt == request.time;
      allow update: if isValidId(ruleId) && isAdmin() && isValidAutomationRule(incoming()) && incoming().id == existing().id && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'channel', 'trigger', 'enabled', 'sentCount', 'conversionCount', 'lastTriggeredAt', 'updatedAt']);
      allow delete: if isValidId(ruleId) && isAdmin();
    }

    match /automationLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId) && isStaffOrAdmin() && isValidAutomationLog(incoming()) && incoming().id == logId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(staffId) && isAdmin() && isValidStaffMember(incoming()) && incoming().id == staffId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(staffId) && isAdmin() && isValidStaffMember(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['active', 'role', 'permissions', 'lastActiveAt', 'updatedAt']);
      allow delete: if isValidId(staffId) && isAdmin();
    }

    match /staffActivity/{activityId} {
      allow get: if isValidId(activityId) && isStaffOrAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(activityId) && isStaffOrAdmin() && isValidStaffActivity(incoming()) && incoming().id == activityId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(activityId) && isAdmin();
    }

    match /takeoverRequests/{reqId} {
      allow get: if isValidId(reqId) && isVerifiedSignedIn() && (existing().userId == request.auth.uid || isStaffOrAdmin());
      allow list: if isVerifiedSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(reqId) && isVerifiedSignedIn() && isValidTakeoverRequest(incoming()) && incoming().id == reqId && incoming().userId == request.auth.uid && incoming().resolved == false && incoming().createdAt == request.time;
      allow update: if isValidId(reqId) && isStaffOrAdmin() && isValidTakeoverRequest(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['resolved']);
      allow delete: if isValidId(reqId) && isAdmin();
    }
  }
}
