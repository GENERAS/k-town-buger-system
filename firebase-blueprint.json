        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["MTN Mobile Money", "Airtel Money", "Pay on Delivery", "Pay at Restaurant"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Confirmed", "Failed", "Refunded"] },
        "paymentReference": { "type": "string", "minLength": 2, "maxLength": 64 },
        "status": { "type": "string", "enum": ["New order received", "Order confirmed", "Preparing food", "Ready for pickup", "Assigned to rider", "Out for delivery", "Delivered", "Completed", "Cancelled"] },
        "statusHistory": { "type": "array" },
        "priority": { "type": "string", "enum": ["Normal", "High"] },
        "kitchenAssignee": { "type": "string", "maxLength": 100 },
        "riderId": { "type": "string", "maxLength": 128 },
        "riderName": { "type": "string", "maxLength": 100 },
        "estimatedMinutes": { "type": "number" },
        "deliveredAt": { "type": "string", "maxLength": 64 },
        "cancellationReason": { "type": "string", "maxLength": 240 },
        "refundAmount": { "type": "number" },
        "inventoryDeducted": { "type": "boolean" },
        "whatsAppSent": { "type": "boolean" },
        "feedbackSubmitted": { "type": "boolean" }
      },
      "required": ["id", "userId", "orderNumber", "createdAt", "updatedAt", "createdAtIso", "updatedAtIso", "customerId", "customerName", "customerPhone", "marketingOptIn", "fulfillmentType", "items", "subtotal", "discount", "deliveryFee", "total", "paymentMethod", "paymentStatus", "paymentReference", "status", "statusHistory", "priority", "estimatedMinutes", "inventoryDeducted", "whatsAppSent"]
    },
    "FeedbackEntry": {
      "title": "FeedbackEntry",
      "description": "Customer rating and feedback tied to a verified order.",
