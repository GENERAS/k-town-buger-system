        "price": { "type": "number" },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "available": { "type": "boolean" },
        "bestseller": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "prepMinutes": { "type": "number" },
        "comboUpgradePrice": { "type": "number" },
        "sizes": { "type": "array" },
        "extras": { "type": "array" },
        "recipe": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "description", "price", "imageUrl", "available", "prepMinutes", "recipe", "createdAt", "updatedAt"]
    },
    "GroupPackage": {
      "title": "GroupPackage",
      "description": "Predefined office, school, or event bulk package.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "audience": { "type": "string", "enum": ["Office", "School", "Party"] },
        "headcount": { "type": "number" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "pricePerPack": { "type": "number" },
        "itemsSummary": { "type": "array" },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "audience", "headcount", "description", "pricePerPack", "itemsSummary", "imageUrl", "updatedAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Promotional discount or free delivery campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "type": { "type": "string", "enum": ["Percentage", "Fixed", "Free Delivery", "First Order", "Birthday", "Group Offer", "Referral"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "scheduleLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "active": { "type": "boolean" },
        "ordersGenerated": { "type": "number" },
        "revenueGenerated": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code", "type", "value", "minOrderAmount", "scheduleLabel", "active", "ordersGenerated", "revenueGenerated", "createdAt", "updatedAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public restaurant storefront configuration and sandbox flags.",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 240 },
        "address": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locationPin": { "type": "string", "minLength": 1, "maxLength": 64 },
        "phone": { "type": "string", "minLength": 4, "maxLength": 30 },
        "whatsappNumber": { "type": "string", "minLength": 4, "maxLength": 30 },
        "openingHours": { "type": "string", "minLength": 1, "maxLength": 100 },
        "currency": { "type": "string", "minLength": 2, "maxLength": 10 },
        "deliveryFeeBase": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "deliveryTargetMinutes": { "type": "number" },
        "activePromoBanner": { "type": "string", "maxLength": 240 },
        "sandboxMode": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantName", "tagline", "address", "locationPin", "phone", "whatsappNumber", "openingHours", "currency", "deliveryFeeBase", "freeDeliveryThreshold", "deliveryTargetMinutes", "activePromoBanner", "sandboxMode", "updatedAt"]
    },
    "QRChannel": {
      "title": "QRChannel",
      "description": "Trackable QR code channel for tables, flyers, and packaging.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "channelType": { "type": "string", "enum": ["Table", "Flyer", "Packaging", "Social"] },
        "sourceCode": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scans": { "type": "number" },
        "ordersCount": { "type": "number" },
        "revenue": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "label", "channelType", "sourceCode", "scans", "ordersCount", "revenue", "createdAt", "updatedAt"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Private customer CRM profile keyed by Firebase Auth UID containing PII and loyalty state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 4, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 160 },
        "birthday": { "type": "string", "maxLength": 20 },
        "firstOrderAt": { "type": "string", "maxLength": 64 },
        "lastOrderAt": { "type": "string", "maxLength": 64 },
        "orderCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "burgerStamps": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "rewardsAvailable": { "type": "number" },
        "favoriteItems": { "type": "array" },
        "segment": { "type": "string", "enum": ["First-Time", "Returning", "VIP", "At-Risk"] },
        "notes": { "type": "string", "maxLength": 500 },
        "marketingOptIn": { "type": "boolean" },
        "referralCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "phone", "firstOrderAt", "lastOrderAt", "orderCount", "totalSpent", "burgerStamps", "loyaltyPoints", "rewardsAvailable", "favoriteItems", "segment", "notes", "marketingOptIn", "referralCode", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with line items, payment status, fulfillment info, and status history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAtIso": { "type": "string", "maxLength": 64 },
        "updatedAtIso": { "type": "string", "maxLength": 64 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "isGroupOrder": { "type": "boolean" },
        "groupOrgName": { "type": "string", "maxLength": 120 },
        "qrSource": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 4, "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "marketingOptIn": { "type": "boolean" },
        "fulfillmentType": { "type": "string", "enum": ["Delivery", "Pickup"] },
        "deliveryZone": { "type": "string", "maxLength": 80 },
        "deliveryAddress": { "type": "string", "maxLength": 240 },
        "locationPin": { "type": "string", "maxLength": 64 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "promoCode": { "type": "string", "maxLength": 32 },
